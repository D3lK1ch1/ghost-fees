# Copy to ~/.config/ghost-it/ghost-it.env (setup.sh does this for you) and keep it private:
#   chmod 600 ~/.config/ghost-it/ghost-it.env
# Never commit the real file. The seed IS the agent: same seed = same address = same @ghostit.
# Keep a copy of the seed in your password manager.

GHOSTIT_LOCAL_SEED=
GHOSTIT_LOCAL_NAME=Ghost.it
GHOSTIT_LOCAL_PORT=8001
GHOSTIT_CARDS=on
GHOSTIT_ADMIN_CODE=

# Optional: only if the $5 Ghost Pack should really charge. Use a restricted key.
PAYMENTS_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
