{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Random id for the anonymous scan session"
    },
    "used_sample": {
      "type": "boolean",
      "default": false
    },
    "leaks_found": {
      "type": "number",
      "default": 0
    },
    "yearly_total": {
      "type": "number",
      "default": 0
    },
    "found_real": {
      "type": "string",
      "enum": [
        "Yes",
        "Kinda",
        "No"
      ]
    },
    "most_useful_leak": {
      "type": "string"
    },
    "confusion_text": {
      "type": "string"
    },
    "would_pay": {
      "type": "string",
      "enum": [
        "Yes",
        "Maybe",
        "No"
      ]
    },
    "builder_name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": ["result", "journey"],
      "default": "result",
      "description": "result: the form under the results. journey: the /try tester walk-through."
    },
    "clarity_app": { "type": "number", "description": "/try: how clear the app was, 1 to 5" },
    "clarity_agent": { "type": "number", "description": "/try: how clear Ghost It was, 1 to 5" },
    "quote_ok": { "type": "boolean", "default": false, "description": "Said yes to being quoted (with builder_name as the first name)" },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "session_id"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}