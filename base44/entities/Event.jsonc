{
  "name": "Event",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "scan_started",
        "scan_finished",
        "cancel_email_clicked",
        "feedback_submitted",
        "guide_opened",
        "guide_message",
        "paywall_shown",
        "try_completed",
        "ask_ghostit_click",
        "sample_finished",
        "guess_revealed"
      ]
    },
    "guess_amount": { "type": "number", "description": "guess_revealed only: what the person guessed (real statements, never the sample)" },
    "real_amount": { "type": "number", "description": "guess_revealed only: the real total found. Used only as an average on /progress" },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "session_id",
    "event_type"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}