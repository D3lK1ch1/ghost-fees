{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "paid": {
      "type": "boolean",
      "default": false,
      "description": "Admin-only manual unlock (e.g. a refund or a gift). Payments are recorded on Allowance. Users can't change this field.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}